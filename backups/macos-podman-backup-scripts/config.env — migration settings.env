# mssql-migration configuration — sourced by migrate.sh
#
# Container names (see `podman ps --format '{{.Names}}'`).
SOURCE_CONTAINER=mssql-source
TARGET_CONTAINER=mssql-target

# sa password for each instance.
SOURCE_SA_PASSWORD="YourSourceSaPassword"
TARGET_SA_PASSWORD="YourTargetSaPassword"

# Databases to migrate, in order.
# Note: names containing ] or ' are not supported by this script.
DATABASES=(AppDb ReportingDb StagingDb ArchiveDb)

# Directory for the .bak files inside BOTH containers.
# /var/opt/mssql/backup exists by default in the mssql images.
#BACKUP_DIR=/var/opt/mssql/backup

# Local staging directory on the Mac — backups pass through here.
#STAGING_DIR=./staging

# Preview mode. Leave unset here so `DRY_RUN=true ./migrate.sh` and the
# VS Code "dry run" task can toggle it. Uncomment to force:
#DRY_RUN=false
